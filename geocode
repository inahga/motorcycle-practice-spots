#!/usr/bin/env python3
"""Geocode an address via OSM Nominatim.

Usage: ./geocode 118 S Damen Ave, Chicago, IL 60612

Use for one-off lookups when adding a spot, per the Nominatim usage
policy (https://operations.osmfoundation.org/policies/nominatim/). Do not
use it for bulk geocoding.
"""

import json
import sys
import urllib.parse
import urllib.request

USER_AGENT = "geocode/1.0 (+https://github.com/inahga/motorcycle-practice-spots)"


def main():
    query = " ".join(sys.argv[1:]).strip()
    if not query:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    url = "https://nominatim.openstreetmap.org/search?" + urllib.parse.urlencode(
        {"q": query, "format": "jsonv2", "limit": 5}
    )
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=30) as resp:
        results = json.load(resp)

    if not results:
        print(f"No results for: {query}", file=sys.stderr)
        return 1

    top = results[0]
    feature = {
        "type": "Feature",
        "geometry": {
            "type": "Point",
            "coordinates": [round(float(top["lon"]), 6), round(float(top["lat"]), 6)],
        },
        "properties": {"name": "FILL ME IN", "address": query, "notes": ""},
    }

    print(f"Top match: {top['display_name']}")
    print(json.dumps(feature, indent=2))

    if len(results) > 1:
        print("\nOther matches:")
        for r in results[1:]:
            print(
                f"  [{float(r['lon']):.6f}, {float(r['lat']):.6f}]  {r['display_name']}"
            )

    print("\nData (c) OpenStreetMap contributors, ODbL.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
